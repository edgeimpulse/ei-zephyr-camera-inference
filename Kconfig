source "Kconfig.zephyr"

menu "Edge Impulse camera inference"

config EI_CAMERA_CAPTURE_WIDTH
	int "Camera capture width in pixels (0: pick automatically)"
	default 0
	help
	  Resolution the sensor streams at, before the frame is cropped and
	  scaled down to the model input size. Leave at 0 to let the app pick
	  the smallest resolution the sensor advertises that still covers the
	  model input, which keeps RAM use and conversion time down.

config EI_CAMERA_CAPTURE_HEIGHT
	int "Camera capture height in pixels (0: pick automatically)"
	default 0

config EI_CAMERA_NUM_BUFS
	int "Number of video buffers"
	default 2
	range 1 8
	help
	  Must be at least the min_vbuf_count the camera driver reports. Two
	  lets the sensor fill one buffer while the impulse runs on the other.

config EI_CAMERA_CAPTURE_TIMEOUT_MS
	int "How long to wait for a frame, in ms (-1: forever)"
	default 2000

config EI_CAMERA_INFERENCE_DELAY_MS
	int "Delay between two inferences, in ms"
	default 0
	help
	  0 runs inference as fast as frames arrive.

config EI_CAMERA_HFLIP
	bool "Flip the image horizontally"
	help
	  Applied by the sensor when it supports VIDEO_CID_HFLIP.

config EI_CAMERA_VFLIP
	bool "Flip the image vertically"
	help
	  Applied by the sensor when it supports VIDEO_CID_VFLIP. Needed on
	  modules whose sensor is mounted upside down.

endmenu
